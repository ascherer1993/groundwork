{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "command-bar",
  "description": "The command bar's window: it hides itself, fits its size, and hands requests to the main window",
  "windows": [
    "command-bar"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:app:allow-app-hide"
  ]
}
