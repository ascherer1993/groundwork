# Build output (app/ and app/src-tauri/ have their own ignores too)
/target
# The CLI and daemon, copied in for the bundle (`make build`)
app/src-tauri/binaries/
node_modules/
dist/
*.tsbuildinfo

# Test output
test-results/
playwright-report/
blob-report/
coverage/

# The fixture vault: activity logs and page state from using it, and
# Obsidian's per-user state if you open it in Obsidian
fixtures/vault/.groundwork/activity/
fixtures/vault/.groundwork/page-state/
fixtures/vault/**/*.page/state.json
fixtures/vault/.obsidian/workspace*.json
fixtures/vault/.obsidian/cache
fixtures/vault/.trash/

# Local settings and secrets
.env
.env.*
.claude/settings.local.json
*.local

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp
*~
*.log
